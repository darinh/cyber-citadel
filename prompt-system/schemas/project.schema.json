{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "project.json — intake answers (CONTENT/CREATIVE choices only; never quality knobs)",
  "type": "object",
  "required": ["topic", "aesthetic", "scope"],
  "properties": {
    "topic": {"type": "string", "description": "What the course teaches."},
    "source_material": {"type": "array", "items": {"type": "string"}, "description": "Paths/URLs/notes the truth layer is built from (or 'user expertise')."},
    "audience": {"type": "string", "description": "e.g. complete beginner, practitioner, manager."},
    "aesthetic": {"type": "string", "description": "Free-text vibe (becomes an ORIGINAL world + characters; never a named franchise)."},
    "scope": {
      "type": "object",
      "properties": {
        "kind": {"type": "string", "enum": ["single_video", "course"]},
        "episodes": {"type": "integer", "description": "For a course."}
      }
    },
    "options": {
      "type": "object",
      "properties": {
        "quizzes": {"type": "boolean", "default": true},
        "study_guide": {"type": "boolean", "default": false},
        "quick_reference": {"type": "boolean", "default": false},
        "avatars": {"type": "boolean", "default": true},
        "music": {"type": "boolean", "default": true}
      }
    },
    "tone": {"type": "string", "description": "e.g. warm and playful, serious, witty."},
    "length": {"type": "string", "description": "Target per-episode length / pacing."},
    "voices": {"type": "string", "description": "How many characters + gender/accent vibes (timbres only)."},
    "language": {"type": "string", "default": "en"}
  }
}
