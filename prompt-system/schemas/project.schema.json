{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "project.json — learner, performance, scope, and optional delivery preferences",
  "type": "object",
  "required": ["schema_version", "topic", "sources", "audience", "desired_performance", "scope", "options", "delivery"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "topic": {"type": "string"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "name", "path_or_url"],
        "properties": {
          "type": {"enum": ["pdf", "doc", "url", "notes", "expert"]},
          "name": {"type": "string"},
          "path_or_url": {"type": "string"}
        }
      }
    },
    "audience": {
      "type": "object",
      "required": ["description", "prior_knowledge", "work_context"],
      "properties": {
        "description": {"type": "string"},
        "prior_knowledge": {"type": "array", "items": {"type": "string"}},
        "work_context": {"type": "string"},
        "accessibility": {"type": "array", "items": {"type": "string"}}
      }
    },
    "desired_performance": {"type": "string", "description": "What learners must be able to do after instruction."},
    "scope": {
      "type": "object",
      "required": ["kind", "episodes"],
      "properties": {
        "kind": {"enum": ["single_video", "course"]},
        "episodes": {"type": "integer", "minimum": 1}
      }
    },
    "options": {
      "type": "object",
      "properties": {
        "quizzes": {"type": "boolean", "default": true},
        "study_guide": {"type": "boolean", "default": false},
        "quick_reference": {"type": "boolean", "default": false},
        "avatars": {"type": "boolean", "default": false},
        "music": {"type": "boolean", "default": false},
        "narrative": {"type": "boolean", "default": false}
      }
    },
    "delivery": {
      "type": "object",
      "required": ["mode", "tone"],
      "properties": {
        "mode": {"enum": ["direct", "documentary", "demonstration", "case-based", "scenario-based", "story", "agent-decides"]},
        "tone": {"type": "string"},
        "aesthetic": {"type": "string", "description": "Optional visual direction; blank means the agent derives a restrained visual system from the subject."},
        "voice_preferences": {"type": "string"}
      }
    },
    "target_length": {"type": "string"},
    "language": {"type": "string", "default": "English"}
  }
}
