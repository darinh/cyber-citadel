{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "assets/media.json — license, provenance, and accessibility for course media",
  "type": "object",
  "required": ["schema_version", "assets"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["path", "kind", "origin", "license", "alt"],
        "properties": {
          "path": {"type": "string"},
          "kind": {"enum": ["image", "video"]},
          "origin": {"enum": ["original", "generated-original", "public-domain", "cc0", "cc-by", "licensed"]},
          "license": {"type": "string"},
          "creator": {"type": "string"},
          "source_url": {"type": "string"},
          "credit": {"type": "string"},
          "fact_ids": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true,
            "description": "Truth-layer facts represented inside the media itself."
          },
          "alt": {"type": "string", "minLength": 1},
          "generation": {
            "type": "object",
            "properties": {
              "tool": {"type": "string"},
              "model": {"type": "string"},
              "prompt": {"type": "string"},
              "seed": {"type": "integer"}
            }
          }
        }
      }
    }
  }
}
