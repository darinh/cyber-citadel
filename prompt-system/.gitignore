# Generated/cache artifacts (do not commit)
__pycache__/
*.pyc
engine/_demo_out/
engine/webtest/node_modules/
engine/webtest/test-results/
.cache/

# A generated course lives in sibling folders when this engine is used; never commit
# someone's generated course back into the prompt-system template:
/course/
/world/
/assets/
/capabilities.json

# generated outputs inside bundled examples (keep example source only)
examples/*/course/episodes/
examples/*/course/render/
examples/*/.cache/

# generated/copied artifacts inside bundled examples (keep example SOURCE only)
examples/*/assets/avatars/
examples/*/course/quizzes.json
examples/*/course/transcripts/
examples/*/index.html
examples/*/watch.html
examples/*/serve.py
examples/*/play.cmd
examples/*/play.sh
examples/*/capabilities.json

# each generated course lives in its own project folder (never commit generated courses)
projects/
